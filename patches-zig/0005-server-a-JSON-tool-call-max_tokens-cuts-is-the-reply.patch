 zig/src/server/tool_json_cut.zig | 110 +++++++++++++++++++++++++++++++
 zig/src/server/tool_stream.zig   |   2 +-
 3 files changed, 112 insertions(+), 1 deletion(-)
 create mode 100644 zig/src/server/tool_json_cut.zig

