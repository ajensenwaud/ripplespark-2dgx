diff --git a/zig/kernels/cuda/ricursive.cu b/zig/kernels/cuda/ricursive.cu
index 3e2d450a3..541def9d9 100644
--- a/zig/kernels/cuda/ricursive.cu
+++ b/zig/kernels/cuda/ricursive.cu
@@ -68,3 +68,22 @@ extern "C" __global__ void __launch_bounds__(256) tf_ripple_norm_add(const float
   const float inv = __fdiv_rn(1.0f, __fsqrt_rn(__fadd_rn(__fdiv_rn(total, (float)width), eps)));
   for (int i = threadIdx.x; i < width; i += 256) x[i] = __fadd_rn(x[i], __fmul_rn(__fmul_rn(a[i], inv), W[i]));
 }
+
+// out [n] = parts[0][i] + parts[1][i] + ... in rank order: two ranks' fp32 o_proj or down_proj partials, added once.
+extern "C" __global__ void __launch_bounds__(256) tf_ripple_rank_sum(const float* __restrict__ parts, float* __restrict__ out,
+                                                                     int64_t n, int world) {
+  const int64_t i = (int64_t)blockIdx.x * 256 + threadIdx.x;
+  if (i >= n) return;
+  float v = parts[i];
+  for (int r = 1; r < world; ++r) v = __fadd_rn(v, parts[r * n + i]);
+  out[i] = v;
+}
+
+// dst [groups, gd, 128] bf16 = the first g heads of each src [groups, gs, 128] group (16-byte moves; pads kept).
+extern "C" __global__ void __launch_bounds__(256) tf_ripple_heads(const uint4* __restrict__ src, uint4* __restrict__ dst, int64_t n,
+                                                                  int g, int gs, int gd) {
+  const int64_t i = (int64_t)blockIdx.x * 256 + threadIdx.x;
+  if (i >= n) return;
+  const int64_t c = i % 16, rest = i / 16, j = rest % g, grp = rest / g;
+  dst[(grp * gd + j) * 16 + c] = src[(grp * gs + j) * 16 + c];
+}
