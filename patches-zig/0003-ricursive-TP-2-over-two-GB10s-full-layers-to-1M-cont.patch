+//! Ripple (model_type ricursive) on CUDA: an ExLlamaV3 pack on one or two GB10s (sm_121), main's operators.
+const std = @import("std");
 pub const config = @import("config.zig");
 pub const kernels = @import("cuda_kernels.zig");
 pub const weights = @import("cuda_weights.zig");
 pub const forward = @import("cuda_forward.zig");
 pub const Model = forward.Model;
 
+/// Bytes this rank's weights take: its share of the cut matrices, plus the bf16 embedding every rank holds whole.
+pub fn weightShare(a: std.mem.Allocator, io: std.Io, dir: []const u8, total: u64) u64 {
+    const p = forward.place() catch return total;
+    forward.admit(121, p.world) catch return total;
+    if (p.world == 1) return total;
+    const path = std.fs.path.join(a, &.{ dir, "config.json" }) catch return total;
+    defer a.free(path);
+    const bytes = std.Io.Dir.cwd().readFileAlloc(io, path, a, .limited(1 << 22)) catch return total;
+    defer a.free(bytes);
+    const c = config.parse(a, bytes) catch return total;
+    return share(total, @as(u64, c.vocab) * c.hidden * 2, p.world);
+}
+
+fn share(total: u64, whole: u64, world: usize) u64 {
+    if (total < whole) return total;
+    return (total - whole) / world + whole;
+}
+
+test "ricursive weight share: the cut part halves, the embedding stays whole" {
+    try std.testing.expectEqual(@as(u64, 1000), share(1000, 2000, 2));
+    try std.testing.expectEqual(@as(u64, 600), share(1000, 200, 2));
+}
+
 test {
     _ = config;
     _ = kernels;
