+fn score(rows: []const f32, v: usize, first: usize, ids: []const u32, tail: usize, stride: usize, nll: *std.ArrayList(f32), top: *std.ArrayList(i32), kept: *std.ArrayList(f32), a: std.mem.Allocator) !void {
