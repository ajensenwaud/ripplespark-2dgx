                                                                 __nv_bfloat16* __restrict__ RV, int kv, long long pos0, int RR, float eps,
@@ -182,7 +182,7 @@ extern "C" __global__ void tf_ripd_embed(const int* __restrict__ IDS, const __nv
   for (int i = threadIdx.x; i < H; i += blockDim.x) OUT[(long long)blockIdx.x * H + i] = bf(e[i]);
 }
 
