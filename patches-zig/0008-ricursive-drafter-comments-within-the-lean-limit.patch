                                                                int block_rows, int heads, int kv_heads, int RR, int window, int layer,
@@ -280,7 +280,7 @@ extern "C" __global__ void __launch_bounds__(128) tf_ripd_attn(const __nv_bfloat
   for (int i = 0; i < DPL; ++i) PO[slot * HD + lane * DPL + i] = out[i];
 }
 
-// The partials of each (row, head) merged in chunk order into OUT bf16 [rows, heads, 128]. Grid (rows, heads), 32 threads.
+// The partials of each (row, head) merged in chunk order into OUT bf16 [rows, heads, 128]. Grid (rows, heads).
 extern "C" __global__ void __launch_bounds__(32) tf_ripd_merge(const float* __restrict__ PM, const float* __restrict__ PL,
                                                                const float* __restrict__ PO, int heads, int chunks,
                                                                __nv_bfloat16* __restrict__ OUT) {
@@ -303,7 +303,7 @@ extern "C" __global__ void __launch_bounds__(32) tf_ripd_merge(const float* __re
   for (int i = 0; i < DPL; ++i) OUT[((size_t)m * heads + h) * HD + lane * DPL + i] = __float2bfloat16_rn(out[i] / sum);
 }
 
