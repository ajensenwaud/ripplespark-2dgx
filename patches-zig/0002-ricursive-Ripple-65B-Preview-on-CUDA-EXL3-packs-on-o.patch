+//! Ripple (model_type ricursive) on CUDA: an ExLlamaV3 pack on one GB10 (sm_121), main's operators plus ricursive.cu.
+pub const config = @import("config.zig");
+pub const kernels = @import("cuda_kernels.zig");
+pub const weights = @import("cuda_weights.zig");
+pub const forward = @import("cuda_forward.zig");
+pub const Model = forward.Model;
+
+test {
+    _ = config;
+    _ = kernels;
+    _ = weights;
+    _ = forward;
+}
diff --git a/zig/src/families/ricursive/cuda_forward.zig b/zig/src/families/ricursive/cuda_forward.zig
new file mode 100644
index 000000000..68e89a111
--- /dev/null
+++ b/zig/src/families/ricursive/cuda_forward.zig
@@ -0,0 +1,189 @@
+//! Ripple's forward on one GB10: rows of one stream at positions p0.., prompt chunks or decode rows, logits out.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const config = @import("config.zig");
+const weights = @import("cuda_weights.zig");
+const Kernels = @import("cuda_kernels.zig").Kernels;
+
+const hd = config.head_dim;
+/// Rows a forward call runs at once: the EXL3 linears' widest call.
+pub const max_rows = 128;
+
+/// A layer's key and value caches, bf16 [ring, kv heads, 128]: a sliding layer's ring holds its window plus a chunk.
+const Cache = struct { kc: cuda.DeviceBuffer, vc: cuda.DeviceBuffer, ring: usize };
+
+const Scratch = struct {
+    ids: cuda.DeviceBuffer,
+    pos: cuda.DeviceBuffer,
+    x: cuda.DeviceBuffer, // fp32 residual [R, hidden]
+    seed: cuda.DeviceBuffer, // fp16 scaled embedding [R, hidden]
+    y: cuda.DeviceBuffer, // fp16 normed [R, hidden]
+    vin: cuda.DeviceBuffer, // fp16 [R, hidden]
+    q: cuda.DeviceBuffer, // bf16 [R, q width] (then the attention output)
+    k: cuda.DeviceBuffer,
+    v: cuda.DeviceBuffer,
+    qo: cuda.DeviceBuffer, // bf16 normed, rotated q [R, heads, 128]
+    ko: cuda.DeviceBuffer,
+    vo: cuda.DeviceBuffer,
+    g: cuda.DeviceBuffer, // fp16 [R, q width]
+    gated: cuda.DeviceBuffer, // fp16 [R, q width]
+    a: cuda.DeviceBuffer, // fp32 [R, hidden]
+    gu: cuda.DeviceBuffer, // fp16 [2, R, intermediate]
+    act: cuda.DeviceBuffer, // fp16 [R, intermediate]
+    logits: cuda.DeviceBuffer, // fp32 [R, vocab]
+    attn: cuda.DeviceBuffer,
+
+    fn all(s: *Scratch) [19]*cuda.DeviceBuffer {
+        return .{ &s.ids, &s.pos, &s.x, &s.seed, &s.y, &s.vin, &s.q, &s.k, &s.v, &s.qo, &s.ko, &s.vo, &s.g, &s.gated, &s.a, &s.gu, &s.act, &s.logits, &s.attn };
+    }
+};
+
+/// What has been validated: sm_121 (GB10) at one rank; every other SM or world is refused by name.
+pub fn admit(sm: u32, world: usize) !void {
+    if (sm != 121) return error.RicursiveRequiresSm121;
+    if (world != 1) return error.RicursiveTpNotValidated;
+}
+
+test "ricursive admission: sm_121 at one rank only" {
+    try admit(121, 1);
+    for ([_]u32{ 80, 86, 89, 90, 100, 120 }) |sm| try std.testing.expectError(error.RicursiveRequiresSm121, admit(sm, 1));
+    try std.testing.expectError(error.RicursiveTpNotValidated, admit(121, 2));
+}
+
+pub const Model = struct {
+    gpa: std.mem.Allocator,
+    d: *const cuda.Driver,
+    stream: cuda.Stream,
+    c: config.Config,
+    w: weights.Weights,
+    dense: cuda.exl3.Dense,
+    norms: cuda.norms.Norms,
+    qk: cuda.qk_rows.QkRows,
+    attn: cuda.window_attention.WindowAttention,
+    k: Kernels,
+    caches: []Cache,
+    inv: cuda.DeviceBuffer,
+    sc: Scratch,
+    context: usize,
+
+    /// Loads `dir` on the context's device: sm_121 only, one GPU (TP=2's cuts are weights.Cut, not yet admitted here).
+    pub fn load(gpa: std.mem.Allocator, io: std.Io, ctx: *const cuda.Context, d: *const cuda.Driver, dir: []const u8, context: usize, truncated: bool) !*Model {
+        try admit(try ctx.capability(), 1);
+        const path = try std.fs.path.join(gpa, &.{ dir, "config.json" });
+        defer gpa.free(path);
+        const bytes = try std.Io.Dir.cwd().readFileAlloc(io, path, gpa, .limited(1 << 22));
+        defer gpa.free(bytes);
+        const c = try config.parse(gpa, bytes);
+        if (!truncated) _ = try c.qualification(); // a truncation only through the parity tool's --truncated
+        if (context == 0 or context > 4096) return error.RicursiveContext; // the full layers' decode kernel reads its ring whole
+        var ck = try core.Checkpoint.openModel(gpa, io, dir);
+        defer ck.close();
+        const m = try gpa.create(Model);
+        errdefer gpa.destroy(m);
+        m.* = .{ .gpa = gpa, .d = d, .stream = try cuda.Stream.init(d, false), .c = c, .w = undefined, .dense = undefined, .norms = undefined, .qk = undefined, .attn = undefined, .k = undefined, .caches = &.{}, .inv = undefined, .sc = undefined, .context = context };
+        m.w = try weights.load(gpa, d, &ck, c, .{});
+        m.dense = try cuda.exl3.Dense.load(d);
+        m.norms = try cuda.norms.Norms.load(d);
+        m.qk = try cuda.qk_rows.QkRows.load(d);
+        m.attn = try cuda.window_attention.WindowAttention.load(d);
+        m.k = try Kernels.load(d);
+        var inv: [hd / 2]f32 = undefined;
+        c.inverseFrequencies(&inv);
+        m.inv = try cuda.DeviceBuffer.fromHost(d, std.mem.sliceAsBytes(&inv));
+        m.caches = try gpa.alloc(Cache, c.layers);
+        const kvb = c.kv_heads * hd * 2;
+        for (m.caches, 0..) |*ca, i| {
+            const ring = if (c.global[i]) context else c.window + max_rows;
+            ca.* = .{ .kc = try cuda.DeviceBuffer.alloc(d, ring * kvb), .vc = try cuda.DeviceBuffer.alloc(d, ring * kvb), .ring = ring };
+        }
+        const R = max_rows;
+        const h = c.hidden;
+        const qw = c.queryWidth();
+        const kw = c.kvWidth();
+        const sizes = [19]usize{ R * 4, R * 4, R * h * 4, R * h * 2, R * h * 2, R * h * 2, R * qw * 2, R * kw * 2, R * kw * 2, R * qw * 2, R * kw * 2, R * kw * 2, R * qw * 2, R * qw * 2, R * h * 4, 2 * R * c.intermediate * 2, R * c.intermediate * 2, R * c.vocab * 4, 256 };
+        for (m.sc.all(), sizes) |b, n| b.* = try cuda.DeviceBuffer.alloc(d, n);
+        return m;
+    }
+
+    pub fn deinit(m: *Model) void {
+        for (m.sc.all()) |b| b.free();
+        for (m.caches) |*ca| {
+            ca.kc.free();
+            ca.vc.free();
+        }
+        m.gpa.free(m.caches);
+        m.inv.free();
+        m.k.unload();
+        m.attn.unload();
+        m.qk.unload();
+        m.norms.unload();
+        m.dense.unload();
+        m.w.deinit();
+        m.stream.deinit();
+        m.gpa.destroy(m);
+    }
+
+    /// Rows `ids` at p0.. in calls of <= `chunk` rows into fp32 logits `out`; `capture`: each layer's fp32 residual.
+    pub fn forward(m: *Model, ids: []const u32, p0: usize, chunk: usize, out: []f32, capture: ?[]f32) !void {
+        if (chunk == 0 or chunk > max_rows or p0 + ids.len > m.context) return error.RicursiveRows;
+        if (out.len != ids.len * m.c.vocab) return error.RicursiveRows;
+        var at: usize = 0;
+        while (at < ids.len) {
+            const n = @min(chunk, ids.len - at);
+            try m.rows(ids[at..][0..n], p0 + at, out[at * m.c.vocab ..][0 .. n * m.c.vocab], capture, at, ids.len);
+            at += n;
+        }
+    }
+
+    fn rows(m: *Model, ids: []const u32, p0: usize, out: []f32, capture: ?[]f32, at: usize, total: usize) !void {
+        const c = m.c;
+        const s = m.stream;
+        const sc = &m.sc;
+        const n = ids.len;
+        const h = c.hidden;
+        const qw = c.queryWidth();
+        var host: [max_rows * 2]i32 = undefined;
+        for (ids, 0..) |id, i| {
+            host[i] = @intCast(id);
+            host[max_rows + i] = @intCast(p0 + i);
+        }
+        try s.synchronize();
+        try sc.ids.upload(0, std.mem.sliceAsBytes(host[0..n]));
+        try sc.pos.upload(0, std.mem.sliceAsBytes(host[max_rows..][0..n]));
+        try m.k.embed(s, sc.ids.ptr, m.w.embed, sc.x.ptr, sc.seed.ptr, n, h, c.embed_scale);
+        for (m.w.layers, m.caches, 0..) |*l, *ca, li| {
+            try m.norms.rms(s, sc.x.ptr, .f32, l.input_norm, sc.y.ptr, .f16, n, h, c.eps);
+            try m.dense.prompt(s, l.q, sc.y.ptr, .f16, n, sc.q.ptr, .bf16);
+            try m.dense.prompt(s, l.k, sc.y.ptr, .f16, n, sc.k.ptr, .bf16);
+            try m.dense.prompt(s, l.g, sc.y.ptr, .f16, n, sc.g.ptr, .f16);
+            try m.k.lerp(s, sc.seed.ptr, sc.y.ptr, sc.vin.ptr, n * h, l.blend); // only V sees the value residual
+            try m.dense.prompt(s, l.v, sc.vin.ptr, .f16, n, sc.v.ptr, .bf16);
+            const ld: i64 = @intCast(qw);
+            const kld: i64 = @intCast(c.kvWidth());
+            const src: cuda.qk_rows.Src = .{ .q = sc.q.ptr, .q_ld = ld, .q_hs = hd, .k = sc.k.ptr, .k_ld = kld, .k_hs = hd, .v = sc.v.ptr, .v_ld = kld, .v_hs = hd };
+            const shape: cuda.qk_rows.Shape = if (l.global) .{ .norms = l.qk_norm, .eps = c.eps } else .{ .norms = l.qk_norm, .inv = m.inv.ptr, .rot = hd, .eps = c.eps };
+            try m.qk.rowsFrom(s, src, .{ .h = c.heads, .hk = c.kv_heads, .dim = hd }, shape, sc.pos.ptr, null, .{ .q = sc.qo.ptr, .k = sc.ko.ptr, .v = sc.vo.ptr, .kc = ca.kc.ptr, .vc = ca.vc.ptr, .len = ca.ring }, n);
+            const win: cuda.window_attention.Window = .{ .h = c.heads, .hk = c.kv_heads, .d = hd, .win = if (l.global) 0 else c.window, .ring = ca.ring, .scale = c.scale() };
+            try m.attn.decode(s, sc.qo.ptr, ca.kc.ptr, ca.vc.ptr, sc.q.ptr, sc.pos.ptr, null, win, sc.attn.ptr, n);
+            try m.k.gate(s, sc.q.ptr, sc.g.ptr, sc.gated.ptr, n * qw);
+            try m.dense.prompt(s, l.o, sc.gated.ptr, .f16, n, sc.a.ptr, .f32);
+            try m.k.normAdd(s, sc.a.ptr, l.post_attn, sc.x.ptr, n, h, c.eps);
+            try m.norms.rms(s, sc.x.ptr, .f32, l.pre_ffn, sc.y.ptr, .f16, n, h, c.eps);
+            const up = sc.gu.ptr + n * c.intermediate * 2;
+            try m.dense.prompt(s, l.gate, sc.y.ptr, .f16, n, sc.gu.ptr, .f16);
+            try m.dense.prompt(s, l.up, sc.y.ptr, .f16, n, up, .f16);
+            try m.k.swiglu(s, sc.gu.ptr, up, sc.act.ptr, n * c.intermediate, c.clamp);
+            try m.dense.prompt(s, l.down, sc.act.ptr, .f16, n, sc.a.ptr, .f32);
+            try m.k.normAdd(s, sc.a.ptr, l.post_ffn, sc.x.ptr, n, h, c.eps);
+            if (capture) |cap| {
+                try s.synchronize();
+                try sc.x.download(0, std.mem.sliceAsBytes(cap[(li * total + at) * h ..][0 .. n * h]));
+            }
+        }
+        try m.norms.rms(s, sc.x.ptr, .f32, m.w.final_norm, sc.y.ptr, .f16, n, h, c.eps);
+        try m.dense.prompt(s, m.w.head, sc.y.ptr, .f16, n, sc.logits.ptr, .f32);
+        try s.synchronize();
+        try sc.logits.download(0, std.mem.sliceAsBytes(out));
+    }
+};
diff --git a/zig/src/families/ricursive/cuda_kernels.zig b/zig/src/families/ricursive/cuda_kernels.zig
new file mode 100644
index 000000000..ae147de6e
--- /dev/null
+++ b/zig/src/families/ricursive/cuda_kernels.zig
@@ -0,0 +1,76 @@
+//! ricursive.cu's kernels: the embedding scale, the value-residual blend, the gate, the clamped SwiGLU, the post-norms.
+const std = @import("std");
+const cuda = @import("cuda");
+
+fn blocks(n: usize) u32 {
+    return @intCast((n + 255) / 256);
+}
+
+pub const Kernels = struct {
+    mod: cuda.Module,
+    embed_fn: cuda.Function,
+    lerp_fn: cuda.Function,
+    gate_fn: cuda.Function,
+    swiglu_fn: cuda.Function,
+    norm_add_fn: cuda.Function,
+
+    pub fn load(d: *const cuda.Driver) !Kernels {
+        if (!cuda.kernels.available) return error.BuiltWithoutKernels;
+        var mod = try cuda.Module.load(d, cuda.kernels.ricursive);
+        errdefer mod.unload();
+        return .{ .mod = mod, .embed_fn = try mod.function("tf_ripple_embed"), .lerp_fn = try mod.function("tf_ripple_lerp"), .gate_fn = try mod.function("tf_ripple_gate"), .swiglu_fn = try mod.function("tf_ripple_swiglu"), .norm_add_fn = try mod.function("tf_ripple_norm_add") };
+    }
+
+    pub fn unload(k: *Kernels) void {
+        k.mod.unload();
+    }
+
+    /// x fp32 [rows, width] = bf16(table[id] * scale), seed fp16 the same rows.
+    pub fn embed(k: *const Kernels, s: cuda.Stream, ids: u64, table: u64, x: u64, seed: u64, rows: usize, width: usize, scale: f32) !void {
+        var a: cuda.Args = .{};
+        for ([_]u64{ ids, table, x, seed }) |v| a.add(v);
+        a.add(@as(i32, @intCast(width)));
+        a.add(scale);
+        try cuda.launch.launch(k.embed_fn, .{ .grid = .{ .x = @intCast(rows) }, .block = .{ .x = 256 } }, s, &a);
+    }
+
+    /// out fp16 [n] = lerp(seed, y, w).
+    pub fn lerp(k: *const Kernels, s: cuda.Stream, seed: u64, y: u64, out: u64, n: usize, w: f32) !void {
+        var a: cuda.Args = .{};
+        for ([_]u64{ seed, y, out }) |v| a.add(v);
+        a.add(@as(i64, @intCast(n)));
+        a.add(w);
+        try cuda.launch.launch(k.lerp_fn, .{ .grid = .{ .x = blocks(n) }, .block = .{ .x = 256 } }, s, &a);
+    }
+
+    /// out fp16 [n] = o (bf16) * sigmoid(g (fp16)).
+    pub fn gate(k: *const Kernels, s: cuda.Stream, o: u64, g: u64, out: u64, n: usize) !void {
+        var a: cuda.Args = .{};
+        for ([_]u64{ o, g, out }) |v| a.add(v);
+        a.add(@as(i64, @intCast(n)));
+        try cuda.launch.launch(k.gate_fn, .{ .grid = .{ .x = blocks(n) }, .block = .{ .x = 256 } }, s, &a);
+    }
+
+    /// out fp16 [n] = silu(min(g, limit)) * clamp(u, -limit, limit).
+    pub fn swiglu(k: *const Kernels, s: cuda.Stream, g: u64, u: u64, out: u64, n: usize, limit: f32) !void {
+        var a: cuda.Args = .{};
+        for ([_]u64{ g, u, out }) |v| a.add(v);
+        a.add(@as(i64, @intCast(n)));
+        a.add(limit);
+        try cuda.launch.launch(k.swiglu_fn, .{ .grid = .{ .x = blocks(n) }, .block = .{ .x = 256 } }, s, &a);
+    }
+
+    /// x fp32 [rows, width] += rms(a) * w (fp32 a and w).
+    pub fn normAdd(k: *const Kernels, s: cuda.Stream, a_: u64, w: u64, x: u64, rows: usize, width: usize, eps: f32) !void {
+        var a: cuda.Args = .{};
+        for ([_]u64{ a_, w, x }) |v| a.add(v);
+        a.add(@as(i32, @intCast(width)));
+        a.add(eps);
+        try cuda.launch.launch(k.norm_add_fn, .{ .grid = .{ .x = @intCast(rows) }, .block = .{ .x = 256 } }, s, &a);
+    }
+};
+
+test "ricursive kernels: one 256-thread block per 256 values" {
+    try std.testing.expectEqual(@as(u32, 1), blocks(1));
+    try std.testing.expectEqual(@as(u32, 160), blocks(40960));
+}
diff --git a/zig/src/families/ricursive/cuda_weights.zig b/zig/src/families/ricursive/cuda_weights.zig
new file mode 100644
index 000000000..c416f4de9
--- /dev/null
+++ b/zig/src/families/ricursive/cuda_weights.zig
@@ -0,0 +1,182 @@
+//! Ripple's EXL3 pack on CUDA: trellis projections as exl3.Weight, norms as fp32, a rank's share at TP cuts.
+const std = @import("std");
+const cuda = @import("cuda");
+const core = @import("core");
+const config = @import("config.zig");
+
+const Weight = cuda.exl3.Weight;
+const mul1_magic: u32 = 0x83DCD12D;
+
+/// A rank's share: q/k/v/g, gate/up and the head by output columns; o and down by input rows (their sums added once).
+pub const Cut = struct {
+    rank: usize = 0,
+    world: usize = 1,
+
+    /// [lo, hi) of `n` for this rank, whole 128-wide blocks.
+    pub fn span(c: Cut, n: usize) !struct { lo: usize, hi: usize } {
+        if (c.world == 0 or c.rank >= c.world or n % (128 * c.world) != 0) return error.RicursiveCut;
+        const part = n / c.world;
+        return .{ .lo = c.rank * part, .hi = (c.rank + 1) * part };
+    }
+};
+
+pub const Layer = struct {
+    global: bool,
+    input_norm: u64,
+    post_attn: u64,
+    pre_ffn: u64,
+    post_ffn: u64,
+    /// q_norm then k_norm, fp32 [2, 128].
+    qk_norm: u64,
+    /// sigmoid(value_res_lambda): v_proj's input is lerp(seed, normed, blend).
+    blend: f32,
+    q: Weight,
+    k: Weight,
+    v: Weight,
+    g: Weight,
+    o: Weight,
+    gate: Weight,
+    up: Weight,
+    down: Weight,
+};
+
+pub const Weights = struct {
+    gpa: std.mem.Allocator,
+    bufs: std.ArrayList(cuda.DeviceBuffer) = .empty,
+    embed: u64 = 0,
+    final_norm: u64 = 0,
+    head: Weight = undefined,
+    layers: []Layer = &.{},
+    bytes: usize = 0,
+
+    pub fn deinit(w: *Weights) void {
+        for (w.bufs.items) |*b| b.free();
+        w.bufs.deinit(w.gpa);
+        w.gpa.free(w.layers);
+    }
+
+    fn put(w: *Weights, d: *const cuda.Driver, bytes: []const u8) !u64 {
+        try w.bufs.ensureUnusedCapacity(w.gpa, 1);
+        const b = try cuda.DeviceBuffer.fromHost(d, bytes);
+        w.bufs.appendAssumeCapacity(b);
+        w.bytes += bytes.len;
+        return b.ptr;
+    }
+};
+
+fn name(buf: []u8, comptime fmt: []const u8, args: anytype) ![]const u8 {
+    return std.fmt.bufPrint(buf, fmt, args);
+}
+
+/// A bf16 vector [n] widened to fp32 on the device (norm weights: y = x * w, no offset).
+fn f32Vec(ck: *core.Checkpoint, key: []const u8, n: usize, out: []f32) !void {
+    const t = try ck.expect(key, .bf16, &.{n});
+    for (out[0..n], 0..) |*o, i| o.* = @bitCast(@as(u32, std.mem.readInt(u16, t.bytes[2 * i ..][0..2], .little)) << 16);
+}
+
+fn norm(w: *Weights, d: *const cuda.Driver, ck: *core.Checkpoint, key: []const u8, n: usize) !u64 {
+    const v = try w.gpa.alloc(f32, n);
+    defer w.gpa.free(v);
+    try f32Vec(ck, key, n, v);
+    return w.put(d, std.mem.sliceAsBytes(v));
+}
+
+pub const Side = enum { columns, rows };
+
+/// An n-by-k EXL3 projection `base` (trellis [k/16][n/16][8 * halves] i16, mul1, fp16 suh [k] and svh [n]), cut.
+fn exl3(w: *Weights, d: *const cuda.Driver, ck: *core.Checkpoint, base: []const u8, n: usize, k: usize, side: Side, cut: Cut) !Weight {
+    var buf: [200]u8 = undefined;
+    const t = try ck.get(try name(&buf, "{s}.trellis", .{base}));
+    if (t.dtype != .i16 or t.rank != 3 or t.dim(0) != k / 16 or t.dim(1) != n / 16 or t.dim(2) % 8 != 0) return error.UnexpectedTensor;
+    const halves = t.dim(2) / 8;
+    const marker = try ck.get(try name(&buf, "{s}.mul1", .{base}));
+    if (marker.bytes.len != 4 or std.mem.readInt(u32, marker.bytes[0..4], .little) != mul1_magic) return error.UnsupportedRicursiveQuantization;
+    const suh = try ck.get(try name(&buf, "{s}.suh", .{base}));
+    const svh = try ck.get(try name(&buf, "{s}.svh", .{base}));
+    if (!suh.is(.f16, &.{k}) or !svh.is(.f16, &.{n})) return error.UnexpectedTensor;
+    const tile = t.dim(2) * 2; // bytes of one 16x16 tile
+    var rk = k;
+    var rn = n;
+    var trellis: u64 = 0;
+    var su: u64 = 0;
+    var sv: u64 = 0;
+    if (cut.world == 1) {
+        trellis = try w.put(d, t.bytes);
+        su = try w.put(d, suh.bytes);
+        sv = try w.put(d, svh.bytes);
+    } else if (side == .rows) { // input rows: a contiguous run of k/16 tile rows and suh's matching span
+        const sp = try cut.span(k);
+        rk = sp.hi - sp.lo;
+        const row = (n / 16) * tile;
+        trellis = try w.put(d, t.bytes[sp.lo / 16 * row .. sp.hi / 16 * row]);
+        su = try w.put(d, suh.bytes[sp.lo * 2 .. sp.hi * 2]);
+        sv = try w.put(d, svh.bytes);
+    } else { // output columns: each tile row's span of n/16 tiles, gathered on the host
+        const sp = try cut.span(n);
+        rn = sp.hi - sp.lo;
+        const row = (n / 16) * tile;
+        const part = (rn / 16) * tile;
+        const g = try w.gpa.alloc(u8, (k / 16) * part);
+        defer w.gpa.free(g);
+        for (0..k / 16) |r| @memcpy(g[r * part ..][0..part], t.bytes[r * row + sp.lo / 16 * tile ..][0..part]);
+        trellis = try w.put(d, g);
+        su = try w.put(d, suh.bytes);
+        sv = try w.put(d, svh.bytes[sp.lo * 2 .. sp.hi * 2]);
+    }
+    const st = cuda.exl3.strides(rk, rn, halves, false);
+    const out: Weight = .{ .trellis = trellis, .suh = su, .svh = sv, .k = @intCast(rk), .n = @intCast(rn), .halves = @intCast(halves), .codebook = .mul1, .stride_k = st.k, .stride_nb = st.nb };
+    if (cuda.exl3.variantIndex(out.halves, out.codebook, cuda.exl3.planOf(out).wk) == null) return error.UnsupportedRicursiveQuantization;
+    return out;
+}
+
+/// The whole pack (or a rank's share) onto the device.
+pub fn load(gpa: std.mem.Allocator, d: *const cuda.Driver, ck: *core.Checkpoint, c: config.Config, cut: Cut) !Weights {
+    if (!c.exl3) return error.UnsupportedRicursivePrecision;
+    var w: Weights = .{ .gpa = gpa };
+    errdefer w.deinit();
+    const h = c.hidden;
+    const t = try ck.expect("model.embed_tokens.weight", .bf16, &.{ c.vocab, h });
+    w.embed = try w.put(d, t.bytes); // every rank holds the whole table (the value residual's seed is the embedding)
+    w.final_norm = try norm(&w, d, ck, "model.norm.weight", h);
+    w.head = try exl3(&w, d, ck, "lm_head", c.vocab, h, .columns, cut);
+    w.layers = try gpa.alloc(Layer, c.layers);
+    var buf: [200]u8 = undefined;
+    var pb: [64]u8 = undefined;
+    for (w.layers, 0..) |*l, i| {
+        const p = try std.fmt.bufPrint(&pb, "model.layers.{d}.", .{i});
+        l.global = c.global[i];
+        l.input_norm = try norm(&w, d, ck, try name(&buf, "{s}input_layernorm.weight", .{p}), h);
+        l.post_attn = try norm(&w, d, ck, try name(&buf, "{s}post_attention_layernorm.weight", .{p}), h);
+        l.pre_ffn = try norm(&w, d, ck, try name(&buf, "{s}pre_feedforward_layernorm.weight", .{p}), h);
+        l.post_ffn = try norm(&w, d, ck, try name(&buf, "{s}post_feedforward_layernorm.weight", .{p}), h);
+        var qk: [2 * config.head_dim]f32 = undefined;
+        try f32Vec(ck, try name(&buf, "{s}self_attn.q_norm.weight", .{p}), config.head_dim, qk[0..config.head_dim]);
+        try f32Vec(ck, try name(&buf, "{s}self_attn.k_norm.weight", .{p}), config.head_dim, qk[config.head_dim..]);
+        l.qk_norm = try w.put(d, std.mem.sliceAsBytes(&qk));
+        const lam = try ck.get(try name(&buf, "{s}self_attn.value_res_lambda", .{p}));
+        if (lam.dtype != .f32 or lam.numel() != 1) return error.UnexpectedTensor;
+        const x: f32 = @bitCast(std.mem.readInt(u32, lam.bytes[0..4], .little));
+        l.blend = 1.0 / (1.0 + @exp(-x)); // torch.sigmoid(lambda).item(), as the reference folds it once
+        const qw = c.queryWidth();
+        const kw = c.kvWidth();
+        l.q = try exl3(&w, d, ck, try name(&buf, "{s}self_attn.q_proj", .{p}), qw, h, .columns, cut);
+        l.k = try exl3(&w, d, ck, try name(&buf, "{s}self_attn.k_proj", .{p}), kw, h, .columns, cut);
+        l.v = try exl3(&w, d, ck, try name(&buf, "{s}self_attn.v_proj", .{p}), kw, h, .columns, cut);
+        l.g = try exl3(&w, d, ck, try name(&buf, "{s}self_attn.g_proj", .{p}), qw, h, .columns, cut);
+        l.o = try exl3(&w, d, ck, try name(&buf, "{s}self_attn.o_proj", .{p}), h, qw, .rows, cut);
+        l.gate = try exl3(&w, d, ck, try name(&buf, "{s}mlp.gate_proj", .{p}), c.intermediate, h, .columns, cut);
+        l.up = try exl3(&w, d, ck, try name(&buf, "{s}mlp.up_proj", .{p}), c.intermediate, h, .columns, cut);
+        l.down = try exl3(&w, d, ck, try name(&buf, "{s}mlp.down_proj", .{p}), h, c.intermediate, .rows, cut);
+    }
+    return w;
+}
+
+test "ricursive cut: halves on 128-wide blocks, refused off them" {
+    const c: Cut = .{ .rank = 1, .world = 2 };
+    const s = try c.span(10240);
+    try std.testing.expectEqual(@as(usize, 5120), s.lo);
+    try std.testing.expectEqual(@as(usize, 10240), s.hi);
+    try std.testing.expectEqual(@as(usize, 50176), (try c.span(100352)).lo);
+    try std.testing.expectError(error.RicursiveCut, c.span(1000));
+    try std.testing.expectError(error.RicursiveCut, (Cut{ .rank = 2, .world = 2 }).span(1024));
+}
diff --git a/zig/tests/ricursive_cuda.zig b/zig/tests/ricursive_cuda.zig
new file mode 100644
index 000000000..329dadad7
--- /dev/null
+++ b/zig/tests/ricursive_cuda.zig
@@ -0,0 +1,143 @@
+//! `tf-ricursive <model dir> <logits|greedy|layers> ...`: Ripple's CUDA forward rows for the exllamav3 parity check.
+const std = @import("std");
+const cuda = @import("cuda");
+const rc = @import("ricursive");
+
+const usage =
+    \\usage: tf-ricursive <model dir> logits <ids> <out.f32> <first> [--truncated]
+    \\       tf-ricursive <model dir> greedy <ids> <out.txt> <count> [--truncated]
+    \\       tf-ricursive <model dir> layers <ids> <out.f32> [--truncated]
+    \\       tf-ricursive <model dir> suite <run dir> <plain|layers> [--truncated]
+    \\suite: for each "name n" line of <run dir>/texts.txt, name.prompt.f32, name.decode.f32 (first n/2), name.greedy.txt
+    \\(32) and with layers name.layers.f32, from one load.
+    \\<ids>: a file of token ids (comma, space or newline separated). logits: the first <first> ids as prompt chunks of
+    \\128 rows, then every later id as its own decode row; fp32 logits [ids, vocab] (first = ids: all prompt; 0: all
+    \\decode rows). greedy: the ids as a prompt, then <count> argmax tokens one decode row at a time, written as text.
+    \\layers: the prompt path's fp32 residual after each layer [layers, ids, hidden]. --truncated admits a layer prefix
+    \\of the release (the parity pack), which a serve never does.
+    \\
+;
+
+pub fn main(init: std.process.Init) !u8 {
+    const a = init.arena.allocator();
+    const args = try init.minimal.args.toSlice(a);
+    if (args.len < 5) {
+        std.debug.print("{s}", .{usage});
+        return 2;
+    }
+    const truncated = std.mem.eql(u8, args[args.len - 1], "--truncated");
+    const mode = args[2];
+    const is_suite = std.mem.eql(u8, mode, "suite");
+    var ids: std.ArrayList(u32) = .empty;
+    if (!is_suite) ids = try readIds(init.io, a, args[3]);
+    var driver = try cuda.Driver.open();
+    defer driver.close();
+    var ctx = try cuda.Context.init(&driver, 0);
+    defer ctx.deinit();
+    const io = init.io;
+    var t0 = now(io);
+    const m = try rc.Model.load(init.gpa, init.io, &ctx, &driver, args[1], 4096, truncated);
+    defer m.deinit();
+    std.debug.print("loaded {d} layers, {d:.2} GiB of weights in {d:.1} s\n", .{ m.c.layers, @as(f64, @floatFromInt(m.w.bytes)) / (1 << 30), now(io) - t0 });
+    const v = m.c.vocab;
+    const n = ids.items.len;
+    if (std.mem.eql(u8, mode, "logits")) {
+        const first = @min(try std.fmt.parseInt(usize, args[5], 10), n);
+        const out = try a.alloc(f32, n * v);
+        t0 = now(io);
+        if (first > 0) try m.forward(ids.items[0..first], 0, rc.forward.max_rows, out[0 .. first * v], null);
+        const tp = now(io) - t0;
+        for (first..n) |i| try m.forward(ids.items[i..][0..1], i, 1, out[i * v ..][0..v], null);
+        std.debug.print("logits: {d} prompt rows in {d:.3} s, {d} decode rows in {d:.3} s\n", .{ first, tp, n - first, now(io) - t0 - tp });
+        try std.Io.Dir.cwd().writeFile(init.io, .{ .sub_path = args[4], .data = std.mem.sliceAsBytes(out) });
+    } else if (std.mem.eql(u8, mode, "greedy")) {
+        const count = try std.fmt.parseInt(usize, args[5], 10);
+        const out = try a.alloc(f32, n * v);
+        try m.forward(ids.items, 0, rc.forward.max_rows, out, null);
+        var gen: std.ArrayList(u8) = .empty;
+        var last = argmax(out[(n - 1) * v ..][0..v]);
+        for (0..count) |i| {
+            try gen.print(a, "{d}{s}", .{ last, if (i + 1 < count) " " else "\n" });
+            if (i + 1 == count) break;
+            try m.forward(&.{last}, n + i, 1, out[0..v], null);
+            last = argmax(out[0..v]);
+        }
+        try std.Io.Dir.cwd().writeFile(init.io, .{ .sub_path = args[4], .data = gen.items });
+    } else if (std.mem.eql(u8, mode, "suite")) {
+        try suite(init, a, m, args[3], std.mem.indexOf(u8, args[4], "layers") != null);
+    } else if (std.mem.eql(u8, mode, "layers")) {
+        const out = try a.alloc(f32, n * v);
+        const cap = try a.alloc(f32, m.c.layers * n * m.c.hidden);
+        try m.forward(ids.items, 0, rc.forward.max_rows, out, cap);
+        try std.Io.Dir.cwd().writeFile(init.io, .{ .sub_path = args[4], .data = std.mem.sliceAsBytes(cap) });
+    } else {
+        std.debug.print("{s}", .{usage});
+        return 2;
+    }
+    return 0;
+}
+
+fn readIds(io: std.Io, a: std.mem.Allocator, path: []const u8) !std.ArrayList(u32) {
+    var ids: std.ArrayList(u32) = .empty;
+    var it = std.mem.tokenizeAny(u8, try std.Io.Dir.cwd().readFileAlloc(io, path, a, .limited(16 << 20)), ", \n");
+    while (it.next()) |t| try ids.append(a, try std.fmt.parseInt(u32, t, 10));
+    return ids;
+}
+
+fn write(io: std.Io, a: std.mem.Allocator, dir: []const u8, name: []const u8, ext: []const u8, data: []const u8) !void {
+    try std.Io.Dir.cwd().writeFile(io, .{ .sub_path = try std.fmt.allocPrint(a, "{s}/{s}.{s}", .{ dir, name, ext }), .data = data });
+}
+
+/// Every text of <dir>/texts.txt through the prompt path, the decode path (second half), greedy 32 and the layers.
+fn suite(init: std.process.Init, a: std.mem.Allocator, m: *rc.Model, dir: []const u8, layers: bool) !void {
+    const io = init.io;
+    const v = m.c.vocab;
+    const list = try std.Io.Dir.cwd().readFileAlloc(io, try std.fmt.allocPrint(a, "{s}/texts.txt", .{dir}), a, .limited(1 << 16));
+    var lines = std.mem.tokenizeScalar(u8, list, '\n');
+    while (lines.next()) |line| {
+        var f = std.mem.tokenizeScalar(u8, line, ' ');
+        const name = f.next() orelse continue;
+        const ids = (try readIds(io, a, try std.fmt.allocPrint(a, "{s}/{s}.ids", .{ dir, name }))).items;
+        const n = ids.len;
+        const out = try a.alloc(f32, n * v);
+        var t0 = now(io);
+        try m.forward(ids, 0, rc.forward.max_rows, out, null);
+        const tp = now(io) - t0;
+        try write(io, a, dir, name, "prompt.f32", std.mem.sliceAsBytes(out));
+        const half = n / 2;
+        try m.forward(ids[0..half], 0, rc.forward.max_rows, out[0 .. half * v], null);
+        t0 = now(io);
+        for (half..n) |i| try m.forward(ids[i..][0..1], i, 1, out[i * v ..][0..v], null);
+        const td = now(io) - t0;
+        try write(io, a, dir, name, "decode.f32", std.mem.sliceAsBytes(out));
+        try m.forward(ids, 0, rc.forward.max_rows, out, null);
+        var gen: std.ArrayList(u8) = .empty;
+        var last = argmax(out[(n - 1) * v ..][0..v]);
+        for (0..32) |i| {
+            try gen.print(a, "{d}{s}", .{ last, if (i + 1 < 32) " " else "\n" });
+            if (i + 1 == 32) break;
+            try m.forward(&.{last}, n + i, 1, out[0..v], null);
+            last = argmax(out[0..v]);
+        }
+        try write(io, a, dir, name, "greedy.txt", gen.items);
+        if (layers) {
+            const cap = try a.alloc(f32, m.c.layers * n * m.c.hidden);
+            try m.forward(ids, 0, rc.forward.max_rows, out, cap);
+            try write(io, a, dir, name, "layers.f32", std.mem.sliceAsBytes(cap));
+        }
+        std.debug.print("{s}: {d} ids, prompt {d:.3} s, {d} decode rows {d:.3} s (eager, beside nothing measured)\n", .{ name, n, tp, n - half, td });
+    }
+}
+
+fn now(io: std.Io) f64 {
+    return @as(f64, @floatFromInt(std.Io.Clock.awake.now(io).toNanoseconds())) / 1e9;
+}
+
+/// The first largest logit (torch's argmax rule).
+fn argmax(row: []const f32) u32 {
+    var best: usize = 0;
+    for (row, 0..) |x, i| if (x > row[best]) {
+        best = i;
+    };
+    return @intCast(best);
+}
-- 
