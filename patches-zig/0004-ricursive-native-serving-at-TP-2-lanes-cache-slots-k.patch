+//! Replies that open their own think block (Ripple's template): the split and its template detection.
+const std = @import("std");
+const rt = @import("reply_text.zig");
+
+test "a reply that opens its own think block splits there, and one that opens none is all answer" {
+    const a = std.testing.allocator;
+    var arena = std.heap.ArenaAllocator.init(a);
+    defer arena.deinit();
+    const x = arena.allocator();
+    const m = rt.reply_think_markers;
+    const plain = try rt.splitThinking(x, "Paris.", true, m);
+    try std.testing.expectEqualStrings("", plain.reasoning);
+    try std.testing.expectEqualStrings("Paris.", plain.answer);
+    const both = try rt.splitThinking(x, "<think>\nThe capital.\n</think>\nParis.", true, m);
+    try std.testing.expectEqualStrings("The capital.\n", both.reasoning);
+    try std.testing.expectEqualStrings("Paris.", both.answer);
+    const call = try rt.splitThinking(x, "<think>\nUse the tool.\n</think>\n\n<tool_call>\n{\"name\": \"f\", \"arguments\": {}}\n</tool_call>", true, m);
+    try std.testing.expectEqualStrings("<tool_call>\n{\"name\": \"f\", \"arguments\": {}}\n</tool_call>", call.answer);
+    const held = try rt.splitThinking(x, "<thi", false, m); // while it may still be the opener, nothing shows
+    try std.testing.expectEqualStrings("", held.answer);
+    try std.testing.expect(rt.repliesOpenThink("{%- if not content.lstrip().startswith('<think>') %}"));
+    try std.testing.expect(!rt.repliesOpenThink("{{- '<|im_start|>assistant\\n<think>\\n' }}"));
+}
